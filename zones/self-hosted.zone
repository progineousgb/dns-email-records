; Self-hosted mail server (Postfix/Dovecot, mailcow, docker-mailserver, Stalwart...)
; Example zone for example.com. Replace example.com, the IPs (RFC 5737
; documentation ranges) and every value marked REPLACE.
; Check with: named-checkzone example.com zones/self-hosted.zone
$ORIGIN example.com.
$TTL 3600
@       IN SOA  ns1.example.com. hostmaster.example.com. (
                2026102101 ; serial
                3600       ; refresh
                900        ; retry
                1209600    ; expire
                300 )      ; negative cache TTL
@       IN NS   ns1.example.com.
@       IN NS   ns2.example.com.
ns1     IN A    192.0.2.53
ns2     IN A    198.51.100.53
@       IN A    192.0.2.10
www     IN CNAME example.com.

; The mail host needs A/AAAA records and a matching PTR (reverse DNS) set at
; your VPS provider: 192.0.2.25 -> mail.example.com. Many receivers reject
; mail from IPs without forward-confirmed reverse DNS.
mail            IN A    192.0.2.25
mail            IN AAAA 2001:db8::25
@               IN MX   10 mail.example.com.

; SPF: "mx" authorizes the hosts in the MX records. -all once you are sure
; nothing else sends as this domain.
@               IN TXT  "v=spf1 mx -all"

; DKIM: generated by your mail server (opendkim-genkey, rspamd, or the admin UI).
; Selector is whatever you configured; "dkim" here.
dkim._domainkey IN TXT  ( "v=DKIM1; k=rsa; p=REPLACE_WITH_PUBLIC_KEY_PART1"
                          "REPLACE_WITH_PUBLIC_KEY_PART2" )

; Client autoconfiguration (optional, RFC 6186)
_submissions._tcp IN SRV 0 1 465 mail.example.com.
_submission._tcp  IN SRV 0 1 587 mail.example.com.
_imaps._tcp       IN SRV 0 1 993 mail.example.com.

; DMARC. Start at p=none and read the reports before tightening.
_dmarc          IN TXT  "v=DMARC1; p=none; rua=mailto:dmarc-reports@example.com"

; TLS reporting (RFC 8460)
_smtp._tls      IN TXT  "v=TLSRPTv1; rua=mailto:tlsrpt@example.com"

; MTA-STS (RFC 8461). Policy file is served from https://mta-sts.example.com/.well-known/mta-sts.txt
; Change id every time the policy file changes.
_mta-sts        IN TXT  "v=STSv1; id=20261021000000"
mta-sts         IN A    192.0.2.10

; CAA (RFC 8659): only Let's Encrypt may issue certificates for this domain.
@               IN CAA  0 issue "letsencrypt.org"
@               IN CAA  0 issuewild ";"
@               IN CAA  0 iodef "mailto:hostmaster@example.com"
